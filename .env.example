# Agent backend: claude (Claude Agent SDK, uses your Claude Code login),
# synthup (requires SYNTHUP_API_URL), or mock (canned responses).
AGENT_BACKEND=claude
# Optional model override for the Claude backend, e.g. claude-opus-4-8
CLAUDE_AGENT_MODEL=
# Company API key for the Claude backend (Anthropic Console). When unset,
# the SDK falls back to the local Claude Code login — fine for solo dev,
# NOT for multi-user testing (everyone would burn your personal seat).
ANTHROPIC_API_KEY=

# SynthUp (only used when AGENT_BACKEND=synthup)
SYNTHUP_API_URL=
SYNTHUP_API_KEY=
SYNTHUP_MOCK=true

# Auth (Google Workspace SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Storage
DATABASE_PATH=./data/studio.db.json
ARTIFACTS_PATH=./storage/artifacts

# External workspaces
STORYBOOK_URL=http://localhost:6006
NEXT_APP_PATH=/path/to/next-app
LOOP_BRAND_SKILL_PATH=./skills/loop-brand-deck

# Allowed email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=bankonloop.com,loop.ca

# Beta analytics
ANALYTICS_ENABLED=true
